# GitHub Personal Access Token
# Required scopes: repo, read:org
# Create one at: https://github.com/settings/tokens/new
GITHUB_TOKEN=your_token_here

# Mode: "org" to search within an organization, "user" for your personal repos
# Defaults to "org" if not set
REPO_TYPE=org

# Your GitHub organization slug (the part in the URL: github.com/org-slug)
# Required when REPO_TYPE=org, ignored when REPO_TYPE=user
GITHUB_ORG=your-org-name

# Your GitHub username
GITHUB_USERNAME=your-username

# Anthropic API key — used to generate resume bullets with Claude
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: filter PRs by date range (YYYY-MM-DD)
# SINCE_DATE=2023-01-01
# UNTIL_DATE=2025-12-31
